# MongoDB
MONGODB_URI=

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Admin onboarding PIN (use a long random value in production)
ADMIN_ONBOARDING_PIN=

# Email (Resend — verify your domain at https://resend.com/domains)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ravencrest Academy <notifications@yourdomain.com>

# Realtime chat
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=

# App URL (public for client-side links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Job Security
CRON_SECRET=your_random_secret_here

# Sentry (Optional)
SENTRY_DSN=
