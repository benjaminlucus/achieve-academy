# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_URL=

# Database
MONGODB_URI=

# Zoom API Integration (Server-to-Server OAuth)
ZOOM_REDIRECT_URL=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email Service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Real-time Messaging (Pusher)
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_CLUSTER=

# File Storage (UploadThing)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Video & Voice Calls (LiveKit)
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cron Jobs
CRON_SECRET=

# Admin
ADMIN_ONBOARDING_PIN=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Redis (Rate Limiting & Caching)
REDIS_URL=

# Rate Limiting
RATE_LIMIT_ENABLED=true

# SMS / OTP Provider (Twilio)
# Set SMS_PROVIDER=twilio for production, mock for development
SMS_PROVIDER=mock
# Sign up at https://www.twilio.com/try-twilio to get these:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# From Twilio Console -> Verify -> Services -> Create Verify Service (uses SMS channel)
TWILIO_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Legacy SMS phone number (not needed for Verify API)
TWILIO_PHONE_NUMBER=+1234567890
# OTP pepper for hash storage (change this to a long random string in production)
OTP_PEPPER=ravencrest-dev-change-me-in-production

# WhatsApp Integration
NEXT_PUBLIC_WHATSAPP_NUMBER=923015040363
NEXT_PUBLIC_WHATSAPP_CHANNEL=https://whatsapp.com/channel/0029VbDOxJoJUM2RyR3K2T1N

# Analytics & SEO
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_CLARITY_PROJECT_ID=XXXXXXXXXX